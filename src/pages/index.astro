---
import CourseTermPanel from "../components/CourseTermPanel.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { course, type CourseTerm } from "../data/course";

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");

const terms: CourseTerm[] = course.terms ?? [];
const defaultTermId = course.defaultTermId ?? terms[0]?.id ?? "default";
const activeTermId = terms.some((term) => term.id === defaultTermId) ? defaultTermId : terms[0]?.id;
const activeTerm = terms.find((term) => term.id === activeTermId) ?? terms[0];
---

<BaseLayout title={`${course.code} 计算机编程 · 2026 Fall · 上海科技大学`} description={course.description}>
  <SiteHeader />
  <main
    id="main-content"
    class="course-detail-page"
    data-course-page
    data-default-term={activeTermId}
  >
    <section class="detail-hero">
      <div class="container">
        <div class="detail-hero-layout">
          <div class="detail-copy">
            <p class="eyebrow">{course.code} · 上海科技大学 信息科学与技术学院</p>
            <h1>{course.title}</h1>
            <p>{course.description}</p>
            <dl class="course-summary" aria-label="课程摘要">
              <div>
                <dt>授课教师</dt>
                <dd>
                  <a class="instructor-link" href={course.instructorUrl} target="_blank" rel="noreferrer">
                    {course.instructor} <span aria-hidden="true">↗</span>
                  </a>
                </dd>
              </div>
              <div>
                <dt>学分 / 课时</dt>
                <dd>{course.credits} · {course.hours}</dd>
              </div>
            </dl>
          </div>

          <aside class="detail-aside">
            {terms.length > 1 ? (
              <div class="term-control" aria-label="学期切换">
                <label for="course-term-select">选择学期</label>
                <div class="term-select-wrap">
                  <select id="course-term-select" data-term-select>
                    {terms.map((term) => (
                      <option
                        value={term.id}
                        selected={term.id === activeTermId}
                        data-term-description={term.description ?? ""}
                      >
                        {term.label}
                      </option>
                    ))}
                  </select>
                </div>
                <p data-term-summary aria-live="polite">{activeTerm?.description}</p>
              </div>
            ) : null}
          </aside>
        </div>
      </div>
    </section>

    <section class="resource-section" aria-label="课程资料">
      <div class="container">
        {
          terms.map((term) => (
            <CourseTermPanel
              courseCode={course.code}
              sections={term.sections ?? []}
              termDescription={term.description}
              termId={term.id}
              termLabel={term.label}
              isActive={term.id === activeTermId}
            />
          ))
        }
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<script is:inline>
  (() => {
    const page = document.querySelector("[data-course-page]");
    if (!page) return;

    const defaultTerm = page.getAttribute("data-default-term");
    const select = page.querySelector("[data-term-select]");
    const panels = Array.from(page.querySelectorAll("[data-term-panel]"));
    const summary = page.querySelector("[data-term-summary]");
    const ids = select
      ? Array.from(select.options).map((option) => option.value)
      : panels.map((panel) => panel.getAttribute("data-term-panel")).filter(Boolean);

    const activate = (requestedTerm, shouldPushState = false) => {
      const term = ids.includes(requestedTerm) ? requestedTerm : defaultTerm;
      if (!term) return;

      if (select) {
        select.value = term;
        const selectedOption = select.options[select.selectedIndex];
        if (summary && selectedOption) summary.textContent = selectedOption.dataset.termDescription || "";
      }

      panels.forEach((panel) => {
        panel.hidden = panel.getAttribute("data-term-panel") !== term;
      });

      if (shouldPushState) {
        const url = new URL(window.location.href);
        if (term === defaultTerm) url.searchParams.delete("term");
        else url.searchParams.set("term", term);
        window.history.pushState({ term }, "", `${url.pathname}${url.search}${url.hash}`);
      }
    };

    if (select) {
      select.addEventListener("change", () => activate(select.value, true));
    }

    window.addEventListener("popstate", () => {
      activate(new URL(window.location.href).searchParams.get("term"), false);
    });

    activate(new URL(window.location.href).searchParams.get("term"), false);
  })();
</script>

<style is:global>
  .course-detail-page .detail-hero {
    position: relative;
    overflow: hidden;
    padding: 36px 0 40px;
    border-bottom: 1px solid var(--vsp-line);
    background: linear-gradient(135deg, rgba(245, 252, 253, 0.88), rgba(218, 241, 245, 0.68));
  }

  .course-detail-page .detail-hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 360px);
    gap: 64px;
    align-items: end;
  }

  .course-detail-page .detail-copy {
    min-width: 0;
  }

  .course-detail-page .detail-aside {
    display: grid;
    gap: 22px;
  }

  .course-detail-page .detail-copy h1 {
    max-width: 820px;
    margin: 0;
    font-size: 3.25rem;
    line-height: 1.12;
    letter-spacing: 0;
  }

  .course-detail-page .detail-copy > p:last-of-type {
    max-width: 780px;
    margin: 18px 0 0;
    color: var(--vsp-text-muted);
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .course-detail-page .course-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 34px;
    margin: 24px 0 0;
  }

  .course-detail-page .course-summary div {
    display: grid;
    gap: 2px;
  }

  .course-detail-page .course-summary dt {
    color: var(--vsp-text-soft);
    font-size: 0.74rem;
    font-weight: 800;
  }

  .course-detail-page .course-summary dd {
    margin: 0;
    color: var(--vsp-text);
    font-weight: 800;
  }

  .course-detail-page .instructor-link {
    color: var(--vsp-primary-deep);
    text-decoration: none;
  }

  .course-detail-page .instructor-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .course-detail-page .term-control {
    display: grid;
    gap: 9px;
    min-width: 0;
    padding-left: 24px;
    border-left: 3px solid var(--vsp-accent);
  }

  .course-detail-page .term-control label {
    color: var(--vsp-text-soft);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .course-detail-page .term-select-wrap {
    position: relative;
  }

  .course-detail-page .term-control select {
    width: 100%;
    min-height: 44px;
    padding: 9px 38px 9px 12px;
    border: 1px solid var(--vsp-line-strong);
    border-radius: var(--vsp-radius-sm);
    color: var(--vsp-text);
    background: var(--vsp-surface);
    font-weight: 800;
  }

  .course-detail-page .term-control p {
    margin: 0;
    color: var(--vsp-text-muted);
    font-size: 0.84rem;
    line-height: 1.55;
  }

  .course-detail-page .resource-section {
    padding: 42px 0 78px;
    background: var(--vsp-bg);
  }

  .course-detail-page .term-panel[hidden] {
    display: none;
  }

  .course-detail-page .course-sections {
    display: grid;
    gap: 66px;
  }

  .course-detail-page .course-section-block {
    display: grid;
    gap: 24px;
    min-width: 0;
  }

  .course-detail-page .course-section-header {
    padding-bottom: 18px;
    border-bottom: 1px solid var(--vsp-line);
  }

  .course-detail-page .course-section-header .eyebrow {
    margin-bottom: 7px;
  }

  .course-detail-page .compact-title {
    margin: 0;
    color: var(--vsp-text);
    font-size: 2.25rem;
    line-height: 1.18;
    letter-spacing: 0;
  }

  .course-detail-page .course-section-header .section-copy {
    max-width: 760px;
    margin: 10px 0 0;
    color: var(--vsp-text-muted);
  }

  .course-detail-page .section-groups {
    display: grid;
    gap: 44px;
  }

  .course-detail-page .course-subsection-block {
    display: grid;
    gap: 18px;
    min-width: 0;
  }

  .course-detail-page .subsection-header {
    display: grid;
    gap: 6px;
    padding-left: 15px;
    border-left: 3px solid var(--vsp-primary);
  }

  .course-detail-page .course-subsection-block.notice .subsection-header {
    border-left-color: var(--vsp-warn);
  }

  .course-detail-page .subsection-header h3,
  .course-detail-page .subsection-header p {
    margin: 0;
  }

  .course-detail-page .subsection-header h3 {
    color: var(--vsp-text);
    font-size: 1.45rem;
    line-height: 1.25;
  }

  .course-detail-page .subsection-header p {
    max-width: 760px;
    color: var(--vsp-text-muted);
  }

  .course-detail-page .unit-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
    min-width: 0;
  }

  .course-detail-page .unit-card {
    position: relative;
    display: grid;
    min-width: 0;
    min-height: 250px;
    align-content: start;
    gap: 22px;
    padding: 24px;
    overflow: hidden;
    border: 1px solid rgba(0, 91, 113, 0.28);
    border-top: 4px solid var(--vsp-primary);
    border-radius: var(--vsp-radius-md);
    background: rgba(255, 255, 255, 0.58);
    box-shadow: 12px 14px 0 rgba(0, 91, 113, 0.055), var(--vsp-shadow-line);
    backdrop-filter: blur(18px) saturate(140%);
    transition: border-color 170ms ease, box-shadow 170ms ease, transform 170ms ease;
  }

  .course-detail-page .unit-card:hover {
    border-color: var(--vsp-line-strong);
    box-shadow: var(--vsp-shadow-soft);
    transform: translateY(-7px) rotate(-0.25deg);
  }

  .course-detail-page .unit-card.wide,
  .course-detail-page .unit-card.notice,
  .course-detail-page .unit-card.coming-soon {
    grid-column: 1 / -1;
  }

  .course-detail-page .unit-card.wide {
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.9fr);
    align-items: center;
    min-height: 210px;
  }

  .course-detail-page .unit-card.asset-grid-card {
    grid-template-columns: 1fr;
  }

  .course-detail-page .unit-card.notice,
  .course-detail-page .unit-card.exam {
    border-left: 4px solid var(--vsp-warn);
  }

  .course-detail-page .unit-card.coming-soon {
    min-height: 220px;
    place-items: center;
    text-align: center;
  }

  .course-detail-page .unit-body {
    display: grid;
    min-width: 0;
    gap: 8px;
  }

  .course-detail-page .unit-id {
    display: inline-flex;
    width: fit-content;
    min-height: 26px;
    align-items: center;
    margin: 0;
    padding: 3px 8px;
    border: 1px solid var(--vsp-line);
    border-radius: var(--vsp-radius-sm);
    color: var(--vsp-primary-deep);
    background: var(--vsp-surface-2);
    font-family: var(--vsp-font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    line-height: 1;
    overflow-wrap: anywhere;
  }

  .course-detail-page .unit-card h3,
  .course-detail-page .unit-card h4,
  .course-detail-page .unit-card p {
    margin: 0;
  }

  .course-detail-page .unit-card h3,
  .course-detail-page .unit-card h4 {
    color: var(--vsp-text);
    font-size: 1.18rem;
    line-height: 1.35;
    letter-spacing: 0;
    overflow-wrap: anywhere;
  }

  .course-detail-page .unit-card.wide h3,
  .course-detail-page .unit-card.wide h4,
  .course-detail-page .unit-card.coming-soon h3,
  .course-detail-page .unit-card.coming-soon h4,
  .course-detail-page .term-empty-state h2 {
    font-size: 1.65rem;
  }

  .course-detail-page .unit-body > p:last-child {
    color: var(--vsp-text-muted);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .course-detail-page .unit-resources {
    display: grid;
    min-width: 0;
    gap: 16px;
  }

  .course-detail-page .resource-group-title {
    margin: 0 0 8px;
    color: var(--vsp-text-soft);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .course-detail-page .slides-actions,
  .course-detail-page .video-actions,
  .course-detail-page .extras-grid {
    display: grid;
    gap: 9px;
  }

  .course-detail-page .slides-actions,
  .course-detail-page .extras-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .course-detail-page .video-actions,
  .course-detail-page .extras-grid.single {
    grid-template-columns: 1fr;
  }

  .course-detail-page .resource-button.span-full {
    grid-column: 1 / -1;
  }

  .course-detail-page .resource-button {
    display: inline-flex;
    min-width: 0;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 9px 12px;
    border: 1px solid var(--vsp-line-strong);
    border-radius: var(--vsp-radius-sm);
    color: var(--vsp-text);
    background: var(--vsp-surface-2);
    font-size: 0.84rem;
    font-weight: 800;
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: border-color 160ms ease, color 160ms ease, background 160ms ease;
  }

  .course-detail-page a.resource-button {
    cursor: pointer;
  }

  .course-detail-page a.resource-button:hover {
    border-color: var(--vsp-primary-deep);
    color: var(--vsp-primary-deep);
    background: var(--vsp-surface-hover);
  }

  .course-detail-page .resource-button.primary {
    border-color: var(--vsp-primary-deep);
    color: var(--vsp-on-primary);
    background: var(--vsp-primary-deep);
  }

  .course-detail-page a.resource-button.primary:hover {
    border-color: var(--vsp-primary-hover);
    color: var(--vsp-on-primary);
    background: var(--vsp-primary-hover);
  }

  .course-detail-page .resource-button.muted {
    border-color: var(--vsp-line);
    color: var(--vsp-text-soft);
    background: var(--vsp-bg-elevated);
    cursor: not-allowed;
    opacity: 0.68;
  }

  .course-detail-page .asset-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--vsp-line);
    border-bottom: 1px solid var(--vsp-line);
  }

  .course-detail-page .asset-column {
    display: grid;
    min-width: 0;
    align-content: start;
    gap: 16px;
    padding: 20px 20px 20px 0;
  }

  .course-detail-page .asset-column + .asset-column {
    padding-right: 0;
    padding-left: 20px;
    border-left: 1px solid var(--vsp-line);
  }

  .course-detail-page .asset-column-copy {
    display: grid;
    gap: 6px;
  }

  .course-detail-page .asset-column-copy p {
    margin: 0;
    color: var(--vsp-text-muted);
    font-size: 0.88rem;
  }

  .course-detail-page .term-empty-state {
    display: grid;
    min-height: 240px;
    place-items: center;
    padding: 34px;
    border: 1px solid var(--vsp-line);
    border-left: 4px solid var(--vsp-warn);
    border-radius: var(--vsp-radius-md);
    background: var(--vsp-surface);
    text-align: center;
  }

  .course-detail-page .term-empty-state > div {
    display: grid;
    max-width: 620px;
    gap: 10px;
  }

  .course-detail-page .term-empty-state h2,
  .course-detail-page .term-empty-state p {
    margin: 0;
  }

  .course-detail-page .term-empty-state p:last-child {
    color: var(--vsp-text-muted);
  }

  @media (max-width: 900px) {
    .course-detail-page .detail-hero-layout {
      grid-template-columns: minmax(0, 1fr) minmax(260px, 310px);
      gap: 34px;
    }

    .course-detail-page .unit-card.wide {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .course-detail-page .detail-hero {
      padding: 22px 0 30px;
    }

    .course-detail-page .detail-hero-layout {
      grid-template-columns: 1fr;
      gap: 26px;
    }

    .course-detail-page .detail-copy h1 {
      font-size: 2.35rem;
    }

    .course-detail-page .detail-copy > p:last-of-type {
      margin-top: 13px;
      font-size: 0.96rem;
    }

    .course-detail-page .course-summary {
      margin-top: 18px;
    }

    .course-detail-page .term-control {
      padding: 16px 0 0;
      border-top: 1px solid var(--vsp-line);
      border-left: 0;
    }

    .course-detail-page .resource-section {
      padding: 34px 0 60px;
    }

    .course-detail-page .course-sections {
      gap: 50px;
    }

    .course-detail-page .compact-title {
      font-size: 1.8rem;
    }

    .course-detail-page .unit-grid {
      grid-template-columns: 1fr;
    }

    .course-detail-page .unit-card {
      min-height: 0;
      padding: 20px;
    }

    .course-detail-page .asset-columns {
      grid-template-columns: 1fr;
    }

    .course-detail-page .asset-column,
    .course-detail-page .asset-column + .asset-column {
      padding: 18px 0;
      border-left: 0;
    }

    .course-detail-page .asset-column + .asset-column {
      border-top: 1px solid var(--vsp-line);
    }
  }

  @media (max-width: 380px) {
    .course-detail-page .slides-actions,
    .course-detail-page .extras-grid {
      grid-template-columns: 1fr;
    }

    .course-detail-page .resource-button.span-full {
      grid-column: 1;
    }
  }
</style>
